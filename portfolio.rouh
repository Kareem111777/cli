<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kareem | SOC Analyst</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #080c10;
    --bg2: #0d1117;
    --bg3: #111820;
    --accent: #00f5c4;
    --accent2: #0088ff;
    --red: #ff4757;
    --text: #c9d1d9;
    --muted: #586069;
    --border: rgba(0,245,196,0.12);
    --glow: 0 0 20px rgba(0,245,196,0.18);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Syne', sans-serif;
    overflow-x: hidden;
  }

  /* Scanline overlay */
  body::before {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.03) 2px,
      rgba(0,0,0,0.03) 4px
    );
    pointer-events: none;
    z-index: 9999;
  }

  /* Noise texture */
  body::after {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    opacity: 0.4;
    pointer-events: none;
    z-index: 9998;
  }

  /* ─── NAV ─── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 4rem;
    background: rgba(8,12,16,0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-logo {
    font-family: 'Space Mono', monospace;
    font-size: 1rem;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .nav-logo span { color: var(--text); }

  nav ul {
    list-style: none;
    display: flex;
    gap: 2rem;
  }

  nav ul a {
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    color: var(--muted);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.2s;
    position: relative;
  }

  nav ul a::after {
    content: '';
    position: absolute;
    bottom: -4px; left: 0;
    width: 0; height: 1px;
    background: var(--accent);
    transition: width 0.3s;
  }

  nav ul a:hover { color: var(--accent); }
  nav ul a:hover::after { width: 100%; }

  .nav-cta {
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 0.5rem 1.2rem;
    text-decoration: none;
    letter-spacing: 0.08em;
    transition: all 0.2s;
  }

  .nav-cta:hover {
    background: var(--accent);
    color: var(--bg);
  }

  /* ─── HERO ─── */
  #hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 6rem 4rem 4rem;
    position: relative;
    overflow: hidden;
  }

  /* Grid background */
  #hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,245,196,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,245,196,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
  }

  /* Glowing orb */
  #hero::after {
    content: '';
    position: absolute;
    top: 10%; right: -5%;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(0,245,196,0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-content {
    max-width: 700px;
    position: relative;
    z-index: 1;
    opacity: 0;
    transform: translateY(30px);
    animation: fadeUp 0.8s ease 0.2s forwards;
  }

  .hero-tag {
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero-tag::before {
    content: '';
    width: 24px; height: 1px;
    background: var(--accent);
  }

  h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    color: #e6edf3;
  }

  h1 em {
    font-style: normal;
    color: var(--accent);
    position: relative;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.7;
    max-width: 520px;
    margin-bottom: 2.5rem;
    font-weight: 400;
  }

  .hero-btns {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    padding: 0.9rem 2rem;
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
    font-weight: 700;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }

  .btn-primary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,0.1);
    transform: translateX(-100%);
    transition: transform 0.3s;
  }

  .btn-primary:hover::after { transform: translateX(0); }

  .btn-secondary {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    padding: 0.9rem 2rem;
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Hero right — avatar + stats */
  .hero-right {
    position: absolute;
    right: 6rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.8s ease 0.5s forwards;
  }

  .avatar-wrap {
    width: 200px; height: 200px;
    border: 1px solid var(--accent);
    position: relative;
    overflow: hidden;
    background: var(--bg3);
  }

  .avatar-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0,245,196,0.08), transparent);
  }

  .avatar-icon {
    width: 100%; height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5rem;
  }

  /* Scanning line on avatar */
  .avatar-scan {
    position: absolute;
    left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    animation: scan 3s linear infinite;
    opacity: 0.7;
  }

  @keyframes scan {
    0% { top: 0; }
    100% { top: 100%; }
  }

  .stats-row {
    display: flex;
    gap: 1.5rem;
  }

  .stat-box {
    border: 1px solid var(--border);
    padding: 1rem 1.2rem;
    text-align: center;
    background: var(--bg2);
    min-width: 80px;
  }

  .stat-num {
    font-family: 'Space Mono', monospace;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--accent);
    display: block;
  }

  .stat-label {
    font-size: 0.65rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 0.3rem;
    display: block;
  }

  /* ─── SECTIONS ─── */
  section {
    padding: 6rem 4rem;
    position: relative;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .section-num {
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .section-title {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    color: #e6edf3;
    letter-spacing: -0.02em;
  }

  .section-line {
    flex: 1;
    height: 1px;
    background: var(--border);
    max-width: 300px;
  }

  /* ─── ABOUT ─── */
  #about { background: var(--bg2); }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .about-text p {
    color: var(--text);
    line-height: 1.8;
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  .about-text p span { color: var(--accent); }

  .about-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .detail-row {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem;
    border: 1px solid var(--border);
    background: var(--bg3);
    transition: border-color 0.2s;
  }

  .detail-row:hover { border-color: rgba(0,245,196,0.3); }

  .detail-key {
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    min-width: 90px;
    padding-top: 2px;
  }

  .detail-val {
    font-size: 0.9rem;
    color: var(--text);
  }

  /* ─── SKILLS ─── */
  #expertise { background: var(--bg); }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .skill-card {
    border: 1px solid var(--border);
    padding: 1.5rem;
    background: var(--bg2);
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
  }

  .skill-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 3px; height: 100%;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.3s;
  }

  .skill-card:hover { border-color: rgba(0,245,196,0.3); box-shadow: var(--glow); }
  .skill-card:hover::before { transform: scaleY(1); }

  .skill-cat {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }

  .skill-name {
    font-size: 1rem;
    font-weight: 700;
    color: #e6edf3;
    margin-bottom: 0.5rem;
  }

  .skill-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.8rem;
  }

  .tool-tag {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    padding: 0.25rem 0.6rem;
    background: rgba(0,245,196,0.07);
    border: 1px solid rgba(0,245,196,0.15);
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  /* ─── PROJECTS ─── */
  #projects { background: var(--bg2); }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    border: 1px solid var(--border);
    background: var(--bg3);
    overflow: hidden;
    transition: all 0.3s;
    position: relative;
  }

  .project-card:hover { border-color: rgba(0,245,196,0.4); box-shadow: var(--glow); }

  .project-header {
    padding: 1.5rem 1.5rem 0;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .project-icon {
    width: 44px; height: 44px;
    background: rgba(0,245,196,0.08);
    border: 1px solid rgba(0,245,196,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
  }

  .project-status {
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    padding: 0.2rem 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-complete { background: rgba(0,245,196,0.1); color: var(--accent); border: 1px solid rgba(0,245,196,0.25); }
  .status-wip { background: rgba(0,136,255,0.1); color: var(--accent2); border: 1px solid rgba(0,136,255,0.25); }

  .project-body { padding: 1.2rem 1.5rem 1.5rem; }

  .project-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #e6edf3;
    margin-bottom: 0.6rem;
  }

  .project-desc {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 1.2rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.2rem;
  }

  .project-tag {
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem;
    padding: 0.2rem 0.55rem;
    background: var(--bg2);
    border: 1px solid var(--border);
    color: var(--muted);
  }

  .project-link {
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
    color: var(--accent);
    text-decoration: none;
    letter-spacing: 0.06em;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: gap 0.2s;
  }

  .project-link:hover { gap: 0.7rem; }

  /* ─── CERTIFICATIONS ─── */
  #certifications { background: var(--bg); }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.2rem;
  }

  .cert-card {
    display: flex;
    gap: 1rem;
    padding: 1.2rem;
    border: 1px solid var(--border);
    background: var(--bg2);
    align-items: flex-start;
    transition: all 0.3s;
  }

  .cert-card:hover { border-color: rgba(0,245,196,0.3); }

  .cert-icon {
    width: 40px; height: 40px;
    background: rgba(0,245,196,0.07);
    border: 1px solid rgba(0,245,196,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .cert-info {}

  .cert-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: #e6edf3;
    margin-bottom: 0.3rem;
    line-height: 1.4;
  }

  .cert-issuer {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    color: var(--accent);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ─── CONTACT ─── */
  #contact { background: var(--bg2); }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-text h3 {
    font-size: 1.8rem;
    font-weight: 800;
    color: #e6edf3;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .contact-text p {
    color: var(--muted);
    line-height: 1.7;
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.2rem;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: all 0.2s;
    background: var(--bg3);
  }

  .social-link:hover { border-color: rgba(0,245,196,0.4); background: rgba(0,245,196,0.04); }

  .social-icon {
    width: 36px; height: 36px;
    background: rgba(0,245,196,0.07);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .social-text { flex: 1; }

  .social-platform {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
  }

  .social-handle {
    font-size: 0.88rem;
    color: var(--text);
    display: block;
  }

  .social-arrow {
    color: var(--muted);
    font-size: 0.8rem;
    transition: color 0.2s, transform 0.2s;
  }

  .social-link:hover .social-arrow { color: var(--accent); transform: translateX(4px); }

  /* Resume download block */
  .resume-block {
    border: 1px solid var(--border);
    padding: 1.5rem;
    background: var(--bg3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .resume-info h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: #e6edf3;
    margin-bottom: 0.3rem;
  }

  .resume-info p {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
  }

  .btn-download {
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    padding: 0.7rem 1.5rem;
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.06em;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: opacity 0.2s;
  }

  .btn-download:hover { opacity: 0.85; }

  /* ─── FOOTER ─── */
  footer {
    padding: 2rem 4rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg);
  }

  .footer-logo {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .footer-logo span { color: var(--accent); }

  .footer-copy {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    color: var(--muted);
    letter-spacing: 0.06em;
  }

  /* ─── ANIMATIONS ─── */
  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Blinking cursor */
  .cursor {
    display: inline-block;
    width: 3px;
    height: 1em;
    background: var(--accent);
    margin-left: 4px;
    vertical-align: middle;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  /* Terminal prefix */
  .term {
    font-family: 'Space Mono', monospace;
    color: var(--accent);
    font-size: 0.8rem;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 900px) {
    nav { padding: 1rem 1.5rem; }
    nav ul { display: none; }
    section { padding: 4rem 1.5rem; }
    #hero { padding: 6rem 1.5rem 4rem; }
    .hero-right { display: none; }
    .about-grid, .contact-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-logo">K<span>.</span>dev</div>
  <ul>
    <li><a href="#about">About</a></li>
    <li><a href="#expertise">Skills</a></li>
    <li><a href="#projects">Projects</a></li>
    <li><a href="#certifications">Certs</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
  <a href="#contact" class="nav-cta">Open to Opportunities →</a>
</nav>

<!-- HERO -->
<section id="hero">
  <div class="hero-content">
    <div class="hero-tag">SOC Analyst · Cybersecurity</div>
    <h1>Kareem.<br><em>Threat Hunter.</em></h1>
    <p class="hero-sub">
      300-level Computer Science student building real-world SOC expertise —
      detecting threats, analyzing logs, and turning alerts into actionable intelligence.
    </p>
    <div class="hero-btns">
      <a href="#projects" class="btn-primary">View My Work →</a>
      <a href="#contact" class="btn-secondary">Let's Connect</a>
    </div>
  </div>

  <div class="hero-right">
    <div class="avatar-wrap">
      <div class="avatar-icon">🛡️</div>
      <div class="avatar-scan"></div>
    </div>
    <div class="stats-row">
      <div class="stat-box">
        <span class="stat-num">1+</span>
        <span class="stat-label">SOC Projects</span>
      </div>
      <div class="stat-box">
        <span class="stat-num">3+</span>
        <span class="stat-label">Certifications</span>
      </div>
      <div class="stat-box">
        <span class="stat-num">300</span>
        <span class="stat-label">CS Level</span>
      </div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="about">
  <div class="section-header reveal">
    <span class="section-num">01 //</span>
    <h2 class="section-title">About</h2>
